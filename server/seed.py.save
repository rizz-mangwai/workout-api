#!/usr/bin/env python3o

from app import app
from models import db, Exercise, Workout, WorkoutExercise
from datetime import date

with app.app_context():
    # Clear and recreate tables
    db.drop_all()
    db.create_all()

    # Workouts
    strength = Workout(
        date=date(2025, 1, 15),
        duration_minutes=50,
        notes="Upper body"
    )
    cardio = Workout(
        date=date(2025, 1, 17),
        duration_minutes=30,
        notes="Cardio day"
    )

    # Exercises
    push_up = Exercise(
        name="Push-up",
        category="strength",
        equipment_needed=False
    )
    squat = Exercise(
        name="Squat",
        category="strength",
        equipment_needed=False
    )
    cycling = Exercise(
        name="Cycling",
        category="cardio",
        equipment_needed=True
    )

    db.session.add_all([strength, cardio, push_up, squat, cycling])
    db.session.flush()

    # WorkoutExercises
    db.session.add_all([
        WorkoutExercise(workout=strength, exercise=push_up, reps=12, sets=3),
        WorkoutExercise(workout=strength, exercise=squat, reps=10, sets=4),
        WorkoutExercise(workout=cardio, exercise=cycling, duration_seconds=1800),
    ])

    db.session.commit()
    print("Seeded 2 workouts, 3 exercises, and 3 workout-exercise records.")
